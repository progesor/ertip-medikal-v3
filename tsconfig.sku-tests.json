{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/lib/sku-engine/**/*.ts",
    "tests/sku-engine/**/*.ts"
  ],
  "exclude": [
    "src/lib/sku-engine/payloadHook.ts"
  ]
}
