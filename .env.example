# Core application configuration
# Generate a unique value with at least 32 characters. Never commit the real value.
PAYLOAD_SECRET=
DATABASE_URI=postgresql://payload:change-this-password@127.0.0.1:5432/ertip_medikal

# Canonical public origin used for metadata and signed email links.
# NEXT_PUBLIC_SITE_URL is preferred; NEXT_PUBLIC_SERVER_URL remains supported.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional Cloudflare Web Analytics token.
# Disable Cloudflare's automatic beacon injection before enabling this value,
# otherwise the page may load duplicate analytics scripts.
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Optional CSP extension lists. Separate origins with spaces or commas.
# Only https:// and wss:// sources are accepted; invalid tokens are ignored.
# Environment changes require a rebuild/redeploy but no source-code change.
CSP_SCRIPT_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=
CSP_FRAME_SRC_EXTRA=
CSP_IMG_SRC_EXTRA=
CSP_MEDIA_SRC_EXTRA=

# SMTP configuration
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Ertip Medikal
SMTP_FROM_ADDRESS=iletisim@example.com

# Optional dedicated signing secrets. When blank, PAYLOAD_SECRET is used.
PROTECTED_DOWNLOAD_SECRET=
UNSUBSCRIBE_SECRET=
