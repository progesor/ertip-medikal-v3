{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/lib/i18n/config.ts",
    "src/lib/i18n/localeBootstrap.ts",
    "src/lib/i18n/newsletterDictionary.ts",
    "src/lib/i18n/uiDictionary.ts",
    "src/lib/i18n/uiTextOverrides.ts",
    "tests/i18n/**/*.ts"
  ]
}
