{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".tmp/i18n-tests",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/lib/i18n/config.ts",
    "src/lib/i18n/localeBootstrap.ts",
    "src/lib/i18n/newsletterDictionary.ts",
    "src/lib/i18n/uiDictionary.ts",
    "src/lib/i18n/uiTextOverrides.ts",
    "tests/i18n/**/*.ts"
  ]
}
