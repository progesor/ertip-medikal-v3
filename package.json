{
  "name": "ertip-medikal-v3",
  "version": "0.1.0",
  "description": "Enterprise Grade Medical Application built with Next.js, Payload CMS, and Drizzle ORM",
  "author": "Ertip Medikal",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm payload:importmap",
    "dev": "next dev --no-server-fast-refresh",
    "prebuild": "pnpm payload:importmap",
    "build": "next build",
    "build:deploy": "pnpm build",
    "build:debug": "next build --debug-prerender",
    "build:webpack": "next build --webpack",
    "start": "pnpm db:migrate && next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:sku": "rimraf .tmp/sku-tests && tsc -p tsconfig.sku-tests.json && node -e \"require('node:fs').writeFileSync('.tmp/sku-tests/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\" && node --test .tmp/sku-tests/tests/sku-engine/legacyPunch.test.js .tmp/sku-tests/tests/sku-engine/generateLegacyVariants.test.js .tmp/sku-tests/tests/sku-engine/configurableRules.test.js && rimraf .tmp/sku-tests",
    "test:quote": "rimraf .tmp/quote-tests && tsc -p tsconfig.quote-tests.json && node -e \"require('node:fs').writeFileSync('.tmp/quote-tests/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\" && node --test .tmp/quote-tests/tests/quote/resolveQuoteItems.test.js && rimraf .tmp/quote-tests",
    "test:i18n": "rimraf .tmp/i18n-tests && tsc -p tsconfig.i18n-tests.json && node -e \"require('node:fs').writeFileSync('.tmp/i18n-tests/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\" && node --test .tmp/i18n-tests/tests/i18n/localeBootstrap.test.js && rimraf .tmp/i18n-tests",
    "test:e2e": "playwright test",
    "security:audit": "pnpm audit --prod --audit-level low",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json,css}\"",
    "clean": "rimraf .next",
    "payload": "payload",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "payload:graphql": "payload generate:graphQLSchema",
    "db:migrate": "payload migrate",
    "db:migrate:status": "payload migrate:status",
    "db:migrate:create": "payload migrate:create",
    "db:baseline:check": "node scripts/adopt-production-migration-baseline.mjs --check",
    "db:baseline:adopt": "node scripts/adopt-production-migration-baseline.mjs --apply",
    "db:drizzle:generate": "drizzle-kit generate",
    "db:drizzle:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.43.0",
    "graphql": "^16.14.2",
    "lucide-react": "^0.577.0",
    "md-editor-rt": "^6.5.6",
    "next": "16.3.3",
    "payload": "3.88.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.10",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.10",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.12",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.4",
      "immutable": "4.3.9",
      "js-yaml": "4.3.0",
      "linkify-it": "5.0.2",
      "markdown-it": "14.3.0",
      "postcss": "8.5.18",
      "sharp": "0.35.4",
      "ws": "8.21.0"
    }
  },
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
