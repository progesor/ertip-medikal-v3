{
  "name": "ertip-medikal-v3",
  "version": "0.1.0",
  "description": "Enterprise Grade Medical Application built with Next.js, Payload CMS, and Drizzle ORM",
  "author": "Ertip Medikal",
  "private": true,
  "type": "module",
  "scripts": {
    "backup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/site-backup.mjs",
    "predev": "pnpm payload:importmap",
    "dev": "next dev --no-server-fast-refresh",
    "prebuild": "pnpm payload:importmap",
    "build": "next build",
    "build:deploy": "pnpm build",
    "build:debug": "next build --debug-prerender",
    "build:webpack": "next build --webpack",
    "start": "pnpm db:migrate && next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:sku": "tsc -p tsconfig.sku-tests.json && tsx --test tests/sku-engine/*.test.ts",
    "test:quote": "tsc -p tsconfig.quote-tests.json && tsx --test tests/quote/*.test.ts",
    "test:i18n": "tsc -p tsconfig.i18n-tests.json && tsx --test tests/i18n/*.test.ts",
    "test:catalog": "tsx --test tests/catalog/*.test.ts",
    "test:e2e": "playwright test",
    "security:audit": "pnpm audit --prod --audit-level low",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json,css}\"",
    "clean": "rimraf .next",
    "payload": "payload",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "payload:graphql": "payload generate:graphQLSchema",
    "db:migrate": "payload migrate",
    "db:migrate:status": "payload migrate:status",
    "db:migrate:create": "payload migrate:create",
    "db:baseline:check": "node scripts/adopt-production-migration-baseline.mjs --check",
    "db:baseline:adopt": "node scripts/adopt-production-migration-baseline.mjs --apply",
    "db:drizzle:generate": "drizzle-kit generate",
    "db:drizzle:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-mcp": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "framer-motion": "^14.14.0",
    "graphql": "^16.15.0",
    "lucide-react": "^1.73.0",
    "md-editor-rt": "^7.1.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "pg": "^8.23.1",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.6.1",
    "tar": "^7.5.23",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1",
    "pnpm": "10.34.9"
  },
  "packageManager": "pnpm@10.34.9"
}
